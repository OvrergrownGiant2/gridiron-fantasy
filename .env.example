# ---------------------------------------------------------------------------
# Gridiron Fantasy — environment template. Copy to .env and fill in.
# Never commit real secrets. All keys stay on the server; none reach the browser.
# ---------------------------------------------------------------------------

NODE_ENV=development            # production enables secure cookies, HSTS, strict origin checks
PORT=8787
PUBLIC_URL=http://localhost:8787 # used in password-reset links and origin checks
TRUST_PROXY=false               # true behind a load balancer / reverse proxy

# PostgreSQL 13+ (16 recommended)
DATABASE_URL=postgresql://gridiron:gridiron@localhost:5432/gridiron
TEST_DATABASE_URL=postgresql://gridiron:gridiron@localhost:5432/gridiron_test

# Background jobs (data sync, waivers, drafts, trade expiry). Run exactly one instance with true.
JOBS_ENABLED=true

# NFL data provider: nflverse | snapshot | sportsdataio | demo | none
#   nflverse = real open data (free, after-game updates) + Sleeper live overlay (unofficial; SLEEPER_LIVE=false to disable)
#   snapshot = frozen nflverse snapshot file (NFL_SNAPSHOT=path)
#   demo  = simulated season, clearly labeled DEMO DATA (refused in production unless ALLOW_DEMO_DATA=true)
#   none  = app runs; every score/stat surface reports DATA UNAVAILABLE
NFL_PROVIDER=nflverse
NFL_SEASON=                     # defaults to the current season
SLEEPER_LIVE=true
NFL_SNAPSHOT=nfl-snapshot.json
ALLOW_DEMO_DATA=false
SPORTSDATAIO_API_KEY=
SPORTSDATAIO_LIVE_POLL_SECONDS=60  # live-game polling interval; idle interval is 15 minutes

# Optional AI assistant (core features never depend on it)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional email for password resets (Resend HTTP API). Without it, production cannot send reset emails.
RESEND_API_KEY=
MAIL_FROM=Gridiron <no-reply@example.com>

SESSION_DAYS=30
